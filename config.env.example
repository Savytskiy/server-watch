ALERT_BOT_URL=http://127.0.0.1:8000
ALERT_BOT_TOKEN=replace-me

# Redis password for madgamehunter's own Redis (madgamehunter_redis container) -
# used to check tasks.watchdog's own heartbeat key, since the in-process
# watchdog is exactly as vulnerable to a silent freeze as anything it
# monitors (see server-watch.sh's own comment on that check).
MADGAMEHUNTER_REDIS_PASSWORD=replace-me
